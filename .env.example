# --- intervals.icu: la fuente principal (fase 2) ---
# Clave personal: intervals.icu -> Settings -> Developer Settings.
# NO expira ni rota: no hay OAuth ni tokens que gestionar para esta fuente.
#
# IMPORTANTE: no la teclees en la Pi. Su teclado pierde y sustituye caracteres,
# y una clave con un caracter perdido da un 401 que parece un problema de la
# API. Escribe este archivo en el PC, copialo con scp y comprueba con
#   python -m sport_report.intervals.verificar
# que imprime la longitud de la clave, nunca la clave.
INTERVALS_API_KEY=
# '0' es la convencion de "el atleta autenticado". Si no funciona, `verificar`
# imprime el id real: copialo aqui.
INTERVALS_ATHLETE_ID=0

# Cual fuente se intenta primero: intervals | strava.
# Con `intervals`, Strava queda como respaldo y solo se usa si intervals.icu
# falla. Con `strava` forzado NO hay respaldo: intervals.icu nunca respalda a
# Strava (no hay respaldo del respaldo).
FUENTE_PRINCIPAL=intervals

# --- Strava: solo respaldo (fase 2) ---
# Registrar una app en https://www.strava.com/settings/api
# Sin esto el sistema funciona, pero se queda sin red de seguridad: si
# intervals.icu cae, esa semana no se reporta nada nuevo.
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
# Opcional: solo para sembrar la primera corrida. Una vez creado
# data/tokens.json este valor deja de leerse. Strava rota el refresh_token en
# cualquier intercambio, por eso el token vigente NO vive en .env.
STRAVA_REFRESH_TOKEN=

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Anthropic ---
ANTHROPIC_API_KEY=
# Semanal: una llamada por semana, modelo economico.
ANTHROPIC_MODEL=claude-haiku-4-5
# Mensual: una llamada al mes. A esa frecuencia el costo es irrelevante y la
# ventaja de un modelo mayor esta en sostener un texto sobre cuatro semanas de
# datos — no en calcular, que lo sigue haciendo Python.
ANTHROPIC_MODEL_MENSUAL=claude-sonnet-5

# --- Operacion ---
TZ_LOCAL=America/Santiago
DATA_DIR=data
LOG_DIR=logs

# Donde dejar los respaldos de data/ (base, tokens, planes y carrera). Por
# defecto ./respaldos, que sirve contra un borrado accidental pero NO contra la
# muerte de la SD: apunta esto a un pendrive montado o a un NAS.
BACKUP_DIR=respaldos
# Cuantos respaldos conservar (uno por corrida semanal).
BACKUP_KEEP=8
