# Todos los dias a las 13:00 hora local de la Pi. Una carrera de la manana ya
# termino y se subio; si no, run_post_carrera reintenta al dia siguiente a la
# misma hora. No choca con el semanal (lunes 07:00).
[Unit]
Description=Revisa a diario si hay que enviar un informe post-carrera

[Timer]
OnCalendar=*-*-* 13:00:00

# Si la Pi estaba apagada a las 13:00, corre apenas arranque. La ventana de
# dias de run_post_carrera cubre ademas varios dias apagada.
Persistent=true

RandomizedDelaySec=5min

Unit=sport-report-carrera.service

[Install]
WantedBy=timers.target
