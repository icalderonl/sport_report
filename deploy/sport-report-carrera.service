# Informe post-carrera. Lo dispara sport-report-carrera.timer cada dia; si no
# hay una carrera de los ultimos dias sin informe, termina sin tocar la red.
[Unit]
Description=Informe post-carrera (el dia de la carrera, 13:00)
Documentation=file:///opt/sport_report/deploy/runbook-pi.md
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=sportreport
Group=sportreport
WorkingDirectory=/opt/sport_report
ExecStart=/opt/sport_report/.venv/bin/python -m sport_report.run_post_carrera

# Misma holgura que el semanal: la ingesta puede esperar por rate limit.
TimeoutStartSec=30min

StandardOutput=journal
StandardError=journal
SyslogIdentifier=sport-report-carrera

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
RestrictSUIDSGID=true
